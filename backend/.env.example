# Backend environment variables (Render / Local)

# Port assigned dynamically by Render; default is 8000 locally
PORT=8000
ENVIRONMENT=production

# Frontend Origin(s) for CORS.
# Accepts comma-separated URLs or wildcard '*'.
# Note: All https://*.vercel.app preview and production domains are automatically allowed.
FRONTEND_URL=http://localhost:3000,https://your-app.vercel.app

# Optional Luna AI tutor key (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Optional Supabase database and authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
